{
  "expo": {
    "name": "Weather Now",
    "slug": "weather-now",
    "scheme": "weathernow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F5F1E8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weathernow.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Weather Now uses your location to show hyperlocal forecasts."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d13fd6c9-cc97-4373-a0f1-85def00d5bdc"
      }
    },
    "owner": "brian101"
  }
}
