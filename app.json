{
  "expo": {
    "name": "Weather Now",
    "slug": "weather-now",
    "scheme": "weathernow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weathernow.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Weather Now uses your location to show hyperlocal forecasts."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F1E8"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F5F1E8"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d13fd6c9-cc97-4373-a0f1-85def00d5bdc"
      }
    },
    "owner": "brian101"
  }
}
